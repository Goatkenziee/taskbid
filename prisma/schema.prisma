generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  imageUrl  String?
  phone     String?
  bio       String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  postedJobs       Job[]      @relation("PostedJobs")
  bids             Bid[]
  reviewsGiven     Review[]   @relation("Reviewer")
  reviewsReceived  Review[]   @relation("Target")
  sentMessages     Message[]  @relation("Sender")
  receivedMessages Message[]  @relation("Receiver")
  notifications    Notification[]
  savedJobs        SavedJob[]
}

model Category {
  id          String @id @default(cuid())
  name        String @unique
  slug        String @unique
  description String
  icon        String

  jobs Job[]
}

model Job {
  id          String   @id @default(cuid())
  title       String
  description String
  budgetMin   Float
  budgetMax   Float
  location    String?
  isRemote    Boolean  @default(false)
  urgent      Boolean  @default(false)
  status      String   @default("open") // open, in_progress, completed, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deadline    DateTime?

  posterId   String
  poster     User     @relation("PostedJobs", fields: [posterId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  bids     Bid[]
  reviews  Review[]
  messages Message[]
  savedBy  SavedJob[]

  @@index([status])
  @@index([posterId])
  @@index([categoryId])
}

model Bid {
  id          String   @id @default(cuid())
  amount      Float
  description String
  timeline    String
  status      String   @default("pending") // pending, accepted, rejected
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  jobId    String
  job      Job    @relation(fields: [jobId], references: [id])
  bidderId String
  bidder   User   @relation(fields: [bidderId], references: [id])

  @@unique([jobId, bidderId])
  @@index([bidderId])
  @@index([status])
}

model Message {
  id        String   @id @default(cuid())
  content   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  jobId     String
  job       Job    @relation(fields: [jobId], references: [id])
  senderId  String
  sender    User   @relation("Sender", fields: [senderId], references: [id])
  receiverId String
  receiver  User   @relation("Receiver", fields: [receiverId], references: [id])

  @@index([jobId])
  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())

  jobId      String
  job        Job    @relation(fields: [jobId], references: [id])
  reviewerId String
  reviewer   User   @relation("Reviewer", fields: [reviewerId], references: [id])
  targetId   String
  target     User   @relation("Target", fields: [targetId], references: [id])

  @@unique([jobId, reviewerId])
  @@index([targetId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   // bid_placed, bid_accepted, job_completed, new_message, review_received
  message   String
  read      Boolean  @default(false)
  link      String?  // URL to the relevant page
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([createdAt])
}

model SavedJob {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User  @relation(fields: [userId], references: [id])
  jobId  String
  job    Job   @relation(fields: [jobId], references: [id])

  @@unique([userId, jobId])
  @@index([userId])
}
